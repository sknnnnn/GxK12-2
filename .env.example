# Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — públicas (expuestas al navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — privilegiada (server-only, nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (pendiente de integrar — ver Arquitectura técnica § 10)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Andreani (pendiente de integrar — ver src/services/shipping/providers/andreani.ts).
# GXK debe conseguir: ser cliente de Andreani con contrato vigente, acceso a
# developers.andreani.com/su sandbox y el/los código(s) de contrato/servicio/
# sucursal de su cuenta. El mecanismo real de autenticación (API-key vs
# usuario+contraseña) todavía no está confirmado oficialmente -- estas dos
# variables son un placeholder reservado, puede que haga falta ampliarlas.
ANDREANI_API_KEY=
ANDREANI_API_URL=

# Correo Argentino (pendiente de integrar — ver Arquitectura técnica § 12)
CORREO_ARGENTINO_API_KEY=
CORREO_ARGENTINO_API_URL=

# Proveedor de email transaccional (pendiente de definir — ver Arquitectura técnica § 13)
EMAIL_PROVIDER_API_KEY=
